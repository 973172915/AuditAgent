# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 数据文件路径
BANK_STATEMENT_PATH=./data/bank_statement.csv
LEDGER_PATH=./data/ledger.csv
SCHEMA_PATH=./data/schema.yaml

# 安全设置
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=30
SQL_WHITELIST_TABLES=bank_statement,ledger

# 日志
AUDIT_LOG_PATH=./logs/audit_log.jsonl
